# ── Frontend — multi-stage build ─────────────────────────────────────────────
#
#  Stage 1 (builder):  Node 22 — installs deps and runs `vite build`
#  Stage 2 (runtime):  Nginx 1.27 — serves compiled static files + API proxy
#
#  The resulting image is self-contained:
#    • serves /usr/share/nginx/html  for the React SPA
#    • proxies /api/*  →  backend:3001  via nginx/default.conf

# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Install dependencies first (better layer cache — only re-runs when package.json changes)
COPY frontend/package*.json ./
RUN npm ci

# Copy source and build
COPY frontend/ ./
RUN npm run build
# Output: /app/dist

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

# Remove default nginx welcome page
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled React app from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx site config (serves static files + proxies /api/ to backend)
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
